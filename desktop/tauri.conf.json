{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastille",
  "version": "0.1.0",
  "identifier": "io.github.denisbourge.pastille",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "just dev", "cwd": "..", "wait": false }
  },
  "app": {
    "windows": [
      {
        "title": "Pastille",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "THIRD-PARTY.md": "THIRD-PARTY.md" },
    "shortDescription": "An electronics simulator for people who have never built a circuit.",
    "copyright": "Denis Bourge",
    "license": "MIT OR Apache-2.0",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
